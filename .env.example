# --- Base de dados -------------------------------------------------------
# Local (PostgreSQL do sandbox/dev):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Vercel + Neon (produção) — usar o endpoint *pooled* nas Runtime Variables:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# Migrações/drizzle-kit: usar o endpoint DIRETO (sem "-pooler").

# --- Tutor com IA (opcional) --------------------------------------------
# Sem esta chave o tutor local (regras de correção) continua a funcionar.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Pool de ligações (opcional) ----------------------------------------
# PG_POOL_MAX=5
